{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC + Qt 6 (Developer PowerShell)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "msvc-debug", "configurePreset": "msvc-debug"}],
  "testPresets": [{"name": "msvc-debug", "configurePreset": "msvc-debug", "output": {"outputOnFailure": true}}]
}
