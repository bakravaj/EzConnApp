{
  "version": 3,
  "configurePresets": [
    {
      "name": "ucrt64-release",
      "displayName": "EzConn MSYS2 UCRT64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {"PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"},
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/c++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [{"name": "ucrt64-release", "configurePreset": "ucrt64-release"}],
  "testPresets": [{"name": "ucrt64-release", "configurePreset": "ucrt64-release", "environment": {"QT_QPA_PLATFORM_PLUGIN_PATH": "C:/msys64/ucrt64/share/qt6/plugins/platforms"}, "output": {"outputOnFailure": true}, "execution": {"timeout": 60}}]
}
